{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitOverride": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "package.scripts.mts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
